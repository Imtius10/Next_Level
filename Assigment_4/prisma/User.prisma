model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  phone        String?
  role         Role       @default(TENANT)
  status       UserStatus @default(ACTIVE)
  profileImage String?

  // Relations when this user acts as a landlord
  properties     Property[]      @relation("LandlordProperties")

  // Relations when this user acts as a tenant
  rentalRequests RentalRequest[] @relation("TenantRentalRequests")
  reviews        Review[]        @relation("TenantReviews")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
